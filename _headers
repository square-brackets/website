# Netlify response headers. Consumed at deploy time, not served.

# ── Applies everywhere. Deliberately NO Content-Security-Policy here. ──
# CSP is set per-document below instead, because this site has two HTML pages
# with genuinely different needs. If a CSP lived on /* as well, a browser would
# receive two CSP headers on /cutlist/ and enforce their INTERSECTION — the
# strict one would still block the app, and the per-path rule would look like it
# simply didn't work. Keep CSP off /*.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# ── Homepage: loads nothing from anywhere but itself. ──
# The script hash covers the inline pre-paint theme script in index.html.
# If you edit that script, regenerate with:
#   node -e "const{readFileSync}=require('fs'),{createHash}=require('crypto');const m=readFileSync('index.html','utf8').match(/<script>([\s\S]*?)<\/script>/);console.log('sha256-'+createHash('sha256').update(m[1]).digest('base64'))"
/
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-2uv8Ttw75fQMxeMfU4B/UAFGRd82zxv/SmxZAH/FZgU='; style-src 'self'; font-src 'self'; img-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/index.html
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-2uv8Ttw75fQMxeMfU4B/UAFGRd82zxv/SmxZAH/FZgU='; style-src 'self'; font-src 'self'; img-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/404.html
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-2uv8Ttw75fQMxeMfU4B/UAFGRd82zxv/SmxZAH/FZgU='; style-src 'self'; font-src 'self'; img-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
#
# ── /cutlist/ — the opticut cutting-plan app (Rust → WebAssembly). ──
# It is a single generated file: one big inline <script>, one inline <style>,
# a few inline style attributes, and a base64 WebAssembly module.
#
# Why 'unsafe-inline' rather than hashes: the file is REGENERATED by
# opticut's build-web.sh, so a hash would change on every rebuild and the page
# would break silently. 'unsafe-inline' is the honest, maintainable choice here.
#
# It costs little, because the fetch directives below are what actually matter:
# default-src 'none' with connect-src 'none' means the page cannot open a
# network connection at all — no fetch, no XHR, no WebSocket, no beacon. Even
# if something were injected into the page, it would have nowhere to send it.
# That enforces opticut's "runs entirely in your browser" claim at the browser
# level, rather than trusting the code to keep its promise.
#
# 'wasm-unsafe-eval' is required: without it the browser refuses to compile the
# WebAssembly module and the app dies on load with an empty results panel.
#
# font-src 'self' is for the one same-origin Inter file the page borrows from the
# homepage. connect-src stays 'none' — a font is not a connection, so the
# no-network property is unaffected.
/cutlist/*
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Fonts are content-stable: their filenames encode family, weight and subset,
# and the files themselves never change. Safe to cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# No build step means no content hashes in filenames, so style.css / main.js /
# index.html must revalidate. They brotli to a few KB and a 304 is cheap.
# If that ever matters, add ?v=N to the hrefs and cache these immutably too.
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.pdf
  Cache-Control: public, max-age=604800
